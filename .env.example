# 복사해서 쓴다
#  - 로컬 개발(npm run dev): .env.local
#  - Docker 운영(docker compose): .env.production
#
# [빌드] 표시는 next build 때 코드에 박힌다 — 바꾸면 이미지를 다시 빌드해야 한다
# [실행] 표시는 서버가 실행할 때 읽는다 — 컨테이너만 다시 띄우면 된다

# ── 서버 · 화면 ──────────────────────────────
# [빌드] Next.js 서버 주소 (metadataBase · OG)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
# [빌드] 브라우저 탭 타이틀 · OG 제목
NEXT_PUBLIC_SERVER_NAME=roomless
# [빌드] 백엔드 게이트웨이 주소 — Docker 안의 서버(route handler)도 이 주소로 부르므로 컨테이너에서 닿는 주소여야 한다
NEXT_PUBLIC_API_URL=http://localhost:3000
# [빌드] Nginx 하위 경로로 띄울 때 basePath (예: /roomless) — 없으면 비운다
NEXT_PUBLIC_LOCAL_SERVER_PREFIX=
# [빌드] 로딩 표시 (1 이면 표시)
NEXT_PUBLIC_LOADING=1

# ── 인증 ─────────────────────────────────────
# [빌드] JWT 검증 키 (서버 route handler 에서만 쓴다 — 클라이언트 코드에서 쓰지 않는다)
NEXT_PUBLIC_JWT_CODE=
# [실행] 쿠키 도메인 (localhost 면 비운다)
SERVER_DOMAIN=
# [실행] next-auth — 운영에서는 NEXTAUTH_SECRET 이 없으면 SNS 로그인이 실패한다
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
# [실행] SNS 로그인
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_SECRET_ID=
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_SECRET_ID=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_SECRET_ID=
APPLE_LOGIN_CLIENT_ID=
APPLE_LOGIN_SECRET_ID=

# ── 이미지 · 외부 연동 ────────────────────────
# [빌드] next/image 로 허용할 원격 이미지 호스트 · 포트
NEXT_IMAGE_HOSTNAME=
NEXT_IMAGE_PORT=3000
# [빌드] 카카오 지도 앱 키
NEXT_PUBLIC_DAUM_MAP_API_KEY=
# [빌드] 구글 애드센스 · GA4 (Scripts.tsx 에서 주석 해제 후 사용)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_GA4_ID=
