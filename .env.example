# 복사해서 쓴다
#  - 로컬 개발(npm run dev): .env.local
#  - 운영 이미지 빌드: .env.production — deskless(쿠버네티스)가 빌드 secret dotenv 로 넘긴다. 실행 env 는 deskless 차트가 넣는다
#
# [빌드] 표시는 next build 때 코드에 박힌다 — 바꾸면 이미지를 다시 빌드해야 한다
# [실행] 표시는 서버가 실행할 때 읽는다 — 파드(컨테이너)만 다시 띄우면 된다

# ── 서버 · 화면 ──────────────────────────────
# [빌드] Next.js 서버 주소 (metadataBase · OG)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
# [빌드] 백엔드 게이트웨이 주소 — 배포된 서버(파드 안 route handler)도 이 주소로 부르므로 파드(컨테이너)에서 닿는 주소여야 한다
#        로컬은 게이트웨이 3000 하나만 (이용자 3010 · 관리자 3020 은 백엔드 내부용 — 넣지 않는다)
NEXT_PUBLIC_API_URL=http://localhost:3000
# [빌드] 하위 경로로 띄울 때(deskless Ingress) basePath (예: /deskless) — 없으면 비운다
NEXT_PUBLIC_LOCAL_SERVER_PREFIX=
# [빌드] 로딩 표시 (1 이면 표시)
NEXT_PUBLIC_LOADING=1

# ── 인증 ─────────────────────────────────────
# [실행] 쿠키 도메인 (localhost 면 비운다)
SERVER_DOMAIN=
# [실행] next-auth — NEXTAUTH_SECRET 은 개발에서도 필요(SNS 로그인 세션을 암호화하고 /api/user/* route 가 getToken 으로 푼다).
#        NEXTAUTH_URL 이 https 면 세션 쿠키가 __Secure- 이름 — 운영은 https 주소로
#        basePath(NEXT_PUBLIC_LOCAL_SERVER_PREFIX)를 쓰면 경로까지: https://example.com/deskless/api/auth (next-auth 는 경로가 있으면 그것을 자기 주소로 쓴다)
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
# [실행] SNS 로그인 — 카카오 · 네이버(각 개발자 콘솔에 콜백 <origin><basePath>/api/auth/callback/kakao · /naver 등록 — 로컬은 http://localhost:5000/api/auth/callback/kakao)
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_SECRET_ID=
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_SECRET_ID=

# ── 이미지 · 외부 연동 ────────────────────────
# [빌드] next/image 로 허용할 원격 이미지 호스트 · 포트
NEXT_IMAGE_HOSTNAME=
NEXT_IMAGE_PORT=3000
# [빌드] 카카오 지도 앱 키
NEXT_PUBLIC_DAUM_MAP_API_KEY=
# [빌드] 토스 결제위젯 연동 클라이언트 키 (토스 개발자센터 "결제위젯 연동 키" — test_gck_… / live_gck_…)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# [실행] 토스 결제위젯 연동 시크릿 키 (test_gsk_… / live_gsk_…) — 결제 승인 route handler 에서만. NEXT_PUBLIC_ 을 붙이지 않는다
TOSS_SECRET_KEY=
# [빌드] 구글 애드센스 · GA4 (Scripts.tsx 에서 주석 해제 후 사용)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_GA4_ID=

# ── 모니터링 지표 ─────────────────────────────
# [실행] Next.js 서버 지표 · 헬스 체크(/metrics · /health/live · /health/ready — 전용 포트, 화면 주소로는 열지 않는다). 비우면 이 PC 안 127.0.0.1:9468
#        쿠버네티스는 deskless 차트가 METRICS_PORT=9464 · METRICS_HOST=0.0.0.0 을 넣는다(클러스터 안에서만 닿는다)
METRICS_PORT=
METRICS_HOST=
