# 복사해서 쓴다 — 로컬 개발 .env.local(npm run dev) · 운영 이미지 빌드 .env.production(deskless 가 빌드 secret 으로 넘기고, 실행 값은 deskless 차트가 넣는다)
# [빌드] 바꾸면 이미지를 다시 빌드 · [실행] 서버(파드)만 다시 띄우면 된다 — 공개 값(NEXT_PUBLIC_*)도 실행 때 읽는다
# 키의 자세한 뜻은 docs/architecture.md "Boundary / Environment"

# ── 웹 서버 ──────────────────────────────────
# [실행] 웹 주소(metadataBase · OG)
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
# [빌드] 하위 경로로 띄울 때 basePath(예: /deskless) — 없으면 비운다
NEXT_PUBLIC_LOCAL_SERVER_PREFIX=
# [실행] 지표 · 헬스 체크 전용 포트 · 바인딩 — 비우면 127.0.0.1:9468(쿠버네티스는 deskless 차트)
METRICS_PORT=
METRICS_HOST=

# ── 게이트웨이(백엔드 API) ──────────────────────
# [실행] 브라우저가 부르는 게이트웨이 주소 — 로컬은 3000 하나(3010 · 3020 은 넣지 않는다)
NEXT_PUBLIC_API_URL=http://localhost:3000
# [실행] 서버(route handler)가 부르는 게이트웨이 주소 — 비우면 위 주소(쿠버네티스는 deskless 차트가 http://gateway:3000)
API_INTERNAL_URL=

# ── 로그인(next-auth · SNS) ─────────────────────
# [실행] 웹 주소(basePath 를 쓰면 경로까지 · https 면 __Secure- 쿠키) · (필수) 세션 암호화 키
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
# [실행] 쿠키 도메인 — localhost 면 비운다
SERVER_DOMAIN=
# [실행] 카카오(REST API 키 · 클라이언트 시크릿 — 지도 키와 다르다) · 네이버 — 각 개발자 콘솔에 콜백 <웹 주소>/api/auth/callback/kakao · naver
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_SECRET_ID=
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_SECRET_ID=

# ── 결제(토스) ───────────────────────────────
# [실행] 결제위젯 클라이언트 키(test_gck_…) · 시크릿 키(test_gsk_… — 결제 승인 route handler 만, NEXT_PUBLIC_ 금지)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 지도(카카오) ─────────────────────────────
# [실행] 지도 앱 키
NEXT_PUBLIC_DAUM_MAP_API_KEY=

# ── 이미지(next/image) ────────────────────────
# [빌드] 허용할 원격 이미지 호스트 · 포트
NEXT_IMAGE_HOSTNAME=
NEXT_IMAGE_PORT=3000

# ── 화면 ────────────────────────────────────
# [실행] 로딩 표시(1 이면 표시)
NEXT_PUBLIC_LOADING=1

# ── 광고 · 분석 ──────────────────────────────
# [실행] 애드센스 · GA4 — Scripts.tsx 주석을 풀면 쓴다
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_GA4_ID=
